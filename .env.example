# The single account. The password is used only once, to create the user when the database is empty.
HAKO_OWNER_EMAIL=you@example.com
HAKO_INITIAL_PASSWORD=change-me-before-first-start

# Shared secret the desktop app sends as "Authorization: Bearer <key>" on /ws/agent.
HAKO_AGENT_KEY=replace-with-a-long-random-string

# Signs session cookies. Changing it logs everyone out.
HAKO_SESSION_SECRET=replace-with-another-long-random-string

# Origin(s) the web app is served from, comma-separated. Used for the Origin check and the cookie.
PUBLIC_ORIGIN=http://localhost:8787,http://localhost:5173

DATA_DIR=./.data
PORT=8787
